# ═══════════════════════════════════════════════════════════
#  mil_OCR_v2 — 파이프라인 서비스 (P1~P6)
#
#  베이스: PaddlePaddle GPU (CUDA 12.6 + CUDNN 9.5)
#  추가: PyTorch (CUDA 12.6) + OpenAI SDK (vLLM 클라이언트)
#
#  CUDA 11.8 → 12.6 전환 사유:
#    H100(sm_90) GPU에서 CUDA 11.8 빌드의 커널 미포함 (error 209)
#
#  프레임워크:
#    - PyTorch (CUDA 12.6) → P1 Real-ESRGAN
#    - OpenAI SDK           → P3 vLLM API 호출
#    - OpenCV, scikit-image → P1 전처리
#    - SQLAlchemy           → P6 DB 적재
#
#  참고: P2 PP-DocLayout 추론은 별도 layout 컨테이너(PaddlePaddle CUDA 12.6)에서 수행.
#        Pipeline은 HTTP로 layout 서비스를 호출합니다.
#
#  ═══ 타이밍 측정 규약 (통합 테스트/벤치마크 IMPORTANT) ═══
#  - 문서별 timing은 반드시 warm-start 기준으로 기록한다.
#  - 실행 전 `PipelineOrchestrator.warmup(run_dummy_inference=True)` 호출 필수.
#    → Real-ESRGAN 가중치 로드, vLLM 멀티모달 프로세서 캐시 등
#      inference-time lazy 로딩 비용을 첫 문서 timing에서 분리.
#  - run_pipeline_with_outputs.py는 자동 warmup 수행, warmup_timings.json 별도 저장.
#  - 상세: docs/TESTING.md §4 "타이밍 측정 규약 — 모델 로딩 분리"
# ═══════════════════════════════════════════════════════════

FROM paddlepaddle/paddle:3.2.0-gpu-cuda12.6-cudnn9.5

LABEL maintainer="mil-ocr-team"
LABEL description="mil_OCR_v2 파이프라인 서비스 (PyTorch + vLLM 클라이언트 + Layout HTTP 클라이언트)"

# ─── 시스템 패키지 ──────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-glx \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ─── PyTorch (CUDA 12.6 호환) ──────────────
RUN pip install --no-cache-dir \
        torch torchvision --index-url https://download.pytorch.org/whl/cu126

# ─── Real-ESRGAN (P1 초해상도) ─────────────
RUN pip install --no-cache-dir \
        realesrgan basicsr \
    && python3 -c "\
import importlib, pathlib; \
p = pathlib.Path(importlib.import_module('torchvision').__file__).parent / 'transforms' / 'functional_tensor.py'; \
p.exists() or p.write_text('from torchvision.transforms.functional import *\n')"

# ─── 공통 의존성 (P2 PaddleOCR는 layout 컨테이너로 이관)
RUN pip install --no-cache-dir \
        opencv-python>=4.9.0 \
        scikit-image>=0.22.0 \
        Pillow>=10.0.0 \
        numpy>=1.26.0 \
        pyyaml

# ─── vLLM 클라이언트 + 후처리 의존성 ──────
RUN pip install --no-cache-dir \
        openai \
        httpx \
        pydantic>=2.6.0 \
        lxml>=5.1.0 \
        pandas>=2.2.0 \
        sqlalchemy>=2.0.0

# ─── PaddleOCR (OCR-augmented 힌트) + PDF 어댑터 ──────
# 폐쇄망 대응: paddleocr는 초기화 시 ~/.paddlex/official_models/에 모델 자동 다운로드를
# 시도하므로 사전에 models/ocr_hint/ 아래에 배치된 가중치를 복사해 둔다.
RUN pip install --no-cache-dir \
        paddleocr>=3.0.0 \
        pymupdf>=1.24.0

COPY models/ocr_hint/ /root/.paddlex/official_models/

# ─── 작업 디렉토리 ──────────────────────────
WORKDIR /workspace
COPY src/ /workspace/src/
COPY configs/ /workspace/configs/
# 통합 테스트 규약(측정 규약 §4)을 컨테이너 내부에서도 참조 가능하도록 포함
COPY docs/TESTING.md /workspace/docs/TESTING.md

LABEL mil_ocr_v2.timing_convention="warm-start only; call PipelineOrchestrator.warmup(run_dummy_inference=True) before measurement. See /workspace/docs/TESTING.md §4."

ENV PYTHONPATH=/workspace
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_CACHE=/workspace/.cache/huggingface

EXPOSE 8080

CMD ["python", "-m", "src.pipeline.server"]
