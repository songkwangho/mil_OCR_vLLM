# ═══════════════════════════════════════════════════════════
#  mil_OCR_v2 — Fine-tuning 환경
#
#  대상 모델:
#    - PP-DocLayout Fine-tuning (PaddlePaddle)
#    - Gemma4 VLM Fine-tuning (PyTorch + PEFT/LoRA)
#
#  베이스: PaddlePaddle GPU (CUDA 11.8 + CUDNN 8.9)
#  추가: PyTorch + PEFT + TRL (LoRA, SFT, DPO)
# ═══════════════════════════════════════════════════════════

FROM paddlepaddle/paddle:3.2.0-gpu-cuda11.8-cudnn8.9

LABEL maintainer="mil-ocr-team"
LABEL description="mil_OCR_v2 Fine-tuning 환경 (PaddlePaddle + PyTorch + PEFT)"

# ─── 시스템 패키지 ──────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-glx \
        libglib2.0-0 \
        git \
    && rm -rf /var/lib/apt/lists/*

# ─── PyTorch (CUDA 11.8 호환) ──────────────
RUN pip install --no-cache-dir \
        torch torchvision --index-url https://download.pytorch.org/whl/cu118

# ─── HuggingFace + Fine-tuning 도구 ───────
RUN pip install --no-cache-dir \
        "transformers>=5.5.0" \
        datasets \
        accelerate \
        peft>=0.10.0 \
        trl>=0.8.0 \
        bitsandbytes \
        wandb

# ─── PaddleOCR (PP-DocLayout Fine-tuning) ──
RUN pip install --no-cache-dir \
        paddleocr>=3.4.0 \
        paddlex

# ─── 공통 의존성 ──────────────────────────
RUN pip install --no-cache-dir \
        opencv-python>=4.9.0 \
        scikit-image>=0.22.0 \
        Pillow>=10.0.0 \
        numpy>=1.26.0 \
        pyyaml \
        pydantic>=2.6.0

# ─── 작업 디렉토리 ──────────────────────────
WORKDIR /workspace

ENV PYTHONPATH=/workspace
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_CACHE=/workspace/.cache/huggingface

CMD ["bash"]
