{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory_sheet",
  "x-mil-ocr-version": "1.0.0",
  "x-mil-ocr-effective-date": "2026-04-01",
  "x-mil-ocr-deprecated": false,
  "title": "물자현황표",
  "description": "DOMAIN.md §2-3 — 물자현황표 필드 추출 스키마 (guided_json용)",
  "type": "object",
  "properties": {
    "analysis": {
      "type": "string",
      "description": "이미지 영역 텍스트 품질, 레이아웃, 모호한 문자를 30~50 토큰으로 간략히 기술"
    },
    "item_name": {
      "type": "string",
      "description": "품목명"
    },
    "stock_qty": {
      "type": "integer",
      "minimum": 0,
      "description": "현재 재고 수량"
    },
    "location": {
      "type": "string",
      "description": "보관 위치"
    },
    "disposal_qty": {
      "type": "integer",
      "minimum": 0,
      "description": "폐기 수량"
    }
  },
  "required": ["analysis"]
}
