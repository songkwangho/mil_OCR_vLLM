{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maintenance_record",
  "x-mil-ocr-version": "1.0.0",
  "x-mil-ocr-effective-date": "2026-04-01",
  "x-mil-ocr-deprecated": false,
  "title": "정비기록서",
  "description": "DOMAIN.md §2-2 — 정비기록서 필드 추출 스키마 (guided_json용)",
  "type": "object",
  "properties": {
    "analysis": {
      "type": "string",
      "description": "이미지 영역 텍스트 품질, 레이아웃, 모호한 문자를 30~50 토큰으로 간략히 기술"
    },
    "equipment_id": {
      "type": "string",
      "description": "장비 식별번호 (알파벳 + 숫자 조합, 예: K21-001)"
    },
    "maintenance_type": {
      "type": "string",
      "description": "정비 유형"
    },
    "date": {
      "type": "string",
      "description": "정비 일자 (YYYY-MM-DD)"
    },
    "technician": {
      "type": "string",
      "description": "정비 담당자"
    },
    "parts_used": {
      "type": "string",
      "description": "사용 부품"
    }
  },
  "required": ["analysis"]
}
