{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maintenance_record",
  "title": "정비기록서",
  "description": "군수 정비기록서 필드 추출 스키마 (guided_json용)",
  "type": "object",
  "properties": {
    "form_type": {
      "type": "string",
      "enum": ["maintenance_record"]
    },
    "equipment_id": {
      "type": "string",
      "description": "장비 식별번호"
    },
    "equipment_name": {
      "type": "string",
      "description": "장비명"
    },
    "unit_code": {
      "type": "string",
      "description": "소속 부대 코드"
    },
    "maintenance_type": {
      "type": "string",
      "description": "정비 유형 (정기, 긴급, 예방 등)"
    },
    "maintenance_date": {
      "type": "string",
      "description": "정비일자 (YYYY-MM-DD)"
    },
    "deployment_date": {
      "type": "string",
      "description": "배치일자 (YYYY-MM-DD)"
    },
    "technician_name": {
      "type": "string",
      "description": "정비자 성명"
    },
    "technician_rank": {
      "type": "string",
      "description": "정비자 직급/계급"
    },
    "description": {
      "type": "string",
      "description": "정비 내용"
    },
    "parts_used": {
      "type": "array",
      "description": "사용 부품 목록",
      "items": {
        "type": "object",
        "properties": {
          "part_nsn": {
            "type": "string",
            "description": "부품 NSN 코드"
          },
          "part_name": {
            "type": "string",
            "description": "부품명"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["part_name", "quantity"]
      }
    },
    "result": {
      "type": "string",
      "description": "정비 결과 (완료, 계속정비, 후송 등)"
    },
    "approver_name": {
      "type": "string",
      "description": "확인자 성명"
    },
    "remarks": {
      "type": "string",
      "description": "비고"
    }
  },
  "required": ["form_type", "equipment_id", "maintenance_date", "technician_name", "result"]
}
